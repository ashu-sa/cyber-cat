#!/bin/sh
set -eu
app_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# GNOME/Wayland's XWayland path supports the floating panel's manual positioning.
# Honour explicit overrides; use native Wayland when XWayland is unavailable.
if [ -z "${QT_QPA_PLATFORM:-}" ]; then
    if [ -n "${DISPLAY:-}" ]; then export QT_QPA_PLATFORM=xcb
    elif [ -n "${WAYLAND_DISPLAY:-}" ]; then export QT_QPA_PLATFORM=wayland
    fi
fi
exec "$app_root/usr/lib/focanopy/Focanopy" "$@"
